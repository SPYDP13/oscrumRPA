# Copier ce fichier en .env et remplir les valeurs

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# GitLab Personal Access Token — GitLab > Settings > Access Tokens > scope: read_repository
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# OrangeScrum credentials
OSCRUM_USERNAME=prenom.nom@domaine.com
OSCRUM_PASSWORD=your_password

# Nom exact du projet OrangeScrum (tel qu'affiché dans l'interface)
OSCRUM_PROJECT=RG_OBF_CONNECTBO

