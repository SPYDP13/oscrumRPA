# Copier en .env (ou utiliser l'assistant de l'application, qui écrit ce fichier).
# Les secrets (tokens, mots de passe, clés API) saisis dans l'assistant vont dans le Trousseau macOS /
# le Gestionnaire d'identification Windows, pas ici. Ceux écrits ici restent utilisés en secours, en clair.

# ── Choix ──────────────────────────────────────────────────
# Sources des tâches : gitlab, outlook ou both
TASK_SOURCE=gitlab
# Analyse IA : claude (CLI Claude Code, sans clé), gemini ou mistral
TASK_REFINER=claude
# Timesheet à remplir : eprojet ou orangescrum
TIMESHEET_TARGET=eprojet

# ── GitLab ─────────────────────────────────────────────────
GITLAB_URL=https://gitlab.orange.bf/api/v4
GITLAB_AUTHOR=Prenom NOM
# Plusieurs valeurs séparées par des virgules
GITLAB_BRANCHES=preprod
GITLAB_PROJECT_IDS=406,404,531
# Secret : GitLab → Préférences → Access Tokens, scope read_api
GITLAB_TOKEN=

# ── Outlook (Exchange, EWS) ────────────────────────────────
EXCHANGE_SERVER=exchmail.orange-cit.ci
EXCHANGE_EMAIL=prenom.nom@orange.com
# Vide = adresse mail ; sinon DOMAINE\login
EXCHANGE_USERNAME=
# Secret
EXCHANGE_PASSWORD=

# ── Analyse IA ─────────────────────────────────────────────
CLAUDE_CLI_PATH=claude
# Vide = modèle par défaut du CLI (ex. sonnet, opus)
CLAUDE_MODEL=
GEMINI_MODEL=gemini-flash-latest
# Secret : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
MISTRAL_AGENT_ID=ag_019f0512d57473a3b28830cbd2517270
MISTRAL_AGENT_VERSION=3
# Secret
MISTRAL_API_KEY=

# ── E-PROJET ───────────────────────────────────────────────
EPROJET_URL=https://e-projet.synelia.tech/EProjet-1
EPROJET_USERNAME=
# Secret
EPROJET_PASSWORD=
# 834 = OBF | MINI APP VAS · 835 = OBF | GUILYFLOW · 836 = OBF | ORANGE CONNECT
EPROJET_PROJECT_ID=836
EPROJET_RESP_EXTERNE=KAMBOU Serge
# Types : -8 Autre, -7 Système, -6 Support Développement, -5 Test, -4 Projet, -3 Developpement,
#         -2 Analyse, -1 Design, 1 Formation, 2 Support Système et Infra, 3 Support Client
EPROJET_TYPE_TACHE_ID=-3
EPROJET_TYPE_TACHE_REUNION_ID=-4
# Statuts : -1 A Faire, -3 En cours, -2 Bloqué, 1 Prêt pour QA, -4 Terminée, -5 Annulée
EPROJET_STATUT_TACHE_ID=-3
EPROJET_STATUT_TERMINEE_ID=-4

# ── OrangeScrum ────────────────────────────────────────────
OSCRUM_URL=https://orangescrum.synelia.tech
OSCRUM_USERNAME=prenom.nom@domaine.com
# Secret
OSCRUM_PASSWORD=
# Nom exact du projet
OSCRUM_PROJECT=RG_OBF_CONNECTBO
# 10 = Update (2 Development, 1 Bug, 15 Projet, 14 Support…)
OSCRUM_TASK_TYPE_ID=10
# 289 = « Moi » pour le compte actuel (id propre à chaque compte)
OSCRUM_ASSIGNEE_ID=289
