# Copier ce fichier en .env et remplir les valeurs

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# GitLab Personal Access Token — GitLab > Settings > Access Tokens > scope: read_repository
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# OrangeScrum credentials
OSCRUM_USERNAME=prenom.nom@domaine.com
OSCRUM_PASSWORD=your_password

# Nom exact du projet OrangeScrum (tel qu'affiché dans l'interface)
OSCRUM_PROJECT=RG_OBF_CONNECTBO

# E-PROJET (nouvelle plateforme) — si absents, OSCRUM_USERNAME / OSCRUM_PASSWORD sont utilisés
EPROJET_USERNAME=votre_login
EPROJET_PASSWORD=your_password
# 834 = MINI APP VAS, 835 = GUILYFLOW, 836 = ORANGE CONNECT
EPROJET_PROJECT_ID=836
EPROJET_RESP_EXTERNE=KAMBOU Serge
# Type : -3 Developpement, -2 Analyse, -5 Test... / Statut : -1 A Faire, -3 En cours, -2 Bloqué, 1 Prêt pour QA
EPROJET_TYPE_TACHE_ID=-3
EPROJET_STATUT_TACHE_ID=-3


# Calendrier Outlook (Exchange Orange CI, via EWS) — laisser vide pour ignorer les réunions
EXCHANGE_SERVER=exchmail.orange-cit.ci
EXCHANGE_EMAIL=prenom.nom@orange.com
# Login Windows si l'adresse mail ne suffit pas, ex: DOMAINE\login
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=your_password
# Type de tâche E-PROJET pour les réunions (-4 = Projet)
EPROJET_TYPE_TACHE_REUNION_ID=-4

# Source des tâches : gitlab (commits), outlook (réunions du calendrier) ou both (les deux)
TASK_SOURCE=gitlab

# ── Ajouts interface (les secrets saisis dans l'interface vont dans le Trousseau macOS, pas ici)
# Analyse IA : claude (CLI Claude Code, sans clé), gemini ou mistral
TASK_REFINER=claude
CLAUDE_MODEL=
GEMINI_MODEL=gemini-flash-latest
# Timesheet à remplir : eprojet ou orangescrum
TIMESHEET_TARGET=eprojet
OSCRUM_URL=https://orangescrum.synelia.tech
# GitLab
GITLAB_URL=https://gitlab.orange.bf/api/v4
GITLAB_AUTHOR=Prenom NOM
GITLAB_BRANCHES=preprod
GITLAB_PROJECT_IDS=406,404,531
